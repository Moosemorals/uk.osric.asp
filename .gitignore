# Secrets
hetzner.token

# Build output. The artifacts layout puts every project's bin/obj under artifacts/;
# the plain patterns cover a build that bypasses Directory.Build.props.
artifacts/
[Bb]in/
[Oo]bj/

# Local SQLite data and journals
*.db
*.db-journal
*.db-wal
*.db-shm

# Keep shared VS Code configs; ignore personal workspace settings.
/.vscode/*
!/.vscode/launch.json
!/.vscode/tasks.json
!/.vscode/extensions.json

# Vim
*.sw?
*~
*.un~
