#
# There are no pull requests here, so nothing reviews a push after the fact: this is the only gate a
# commit passes before it becomes the truth. It runs the same target CI would, so there is nothing
# here to keep in step. `git push --no-verify` skips it, deliberately.

exec make --no-print-directory check
