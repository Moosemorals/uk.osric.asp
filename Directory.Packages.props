<Project>
  <!--
    Central Package Management. Versions are pinned here; projects reference packages by name only.
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- EF Core Design pulls in the Roslyn Workspaces packages; pin them to the compiler version
         Runtime is built against, or their exact CodeAnalysis.Common dependency conflicts. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- A pure-managed ECMAScript parser for the assistant's script tools (DEC-146). It parses and
         does not execute, has no native asset and is referenced only by Runtime. -->
    <PackageVersion Include="Acornima" Version="1.9.1" />
    <!-- The Markdown parser for stored pages and the assistant transcript. Referenced only by
         Runtime, which is where the rest of the host's parsing lives. -->
    <PackageVersion Include="Markdig" Version="1.6.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.14" />
    <!-- The one package that turns "nothing is public unless another product assembly needs it" from
         a paragraph in the architecture document into a build failure. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageVersion Include="Microsoft.Playwright.NUnit" Version="1.59.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.14" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="NUnit" Version="5.0.0" />
    <PackageVersion Include="NUnit.Analyzers" Version="4.15.0" />
    <PackageVersion Include="NUnit3TestAdapter" Version="6.3.1" />
    <PackageVersion Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" Version="1.20.1-beta.1" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="2.1.13" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.1" />
  </ItemGroup>
</Project>
