# The image is the publish output and nothing else: the SDK is not in it, and no build tool is. Build
# it with `make image`, which publishes to artifacts/ first and passes that directory as the context
# — so `COPY .` is exactly the files the app runs from.
#
# The base is pinned by its arm64 image digest. A tag would let the base move between two builds of
# one commit, which is the one part of the image this repository does not control. MCR does not
# resolve its manifest-list digest, so x86 builds must pass the matching amd64 image digest as
# BASE_IMAGE. `make image` builds for linux/arm64, matching the CAX21 host. Bump the pin deliberately.
#
# `-extra` supplies /usr/share/zoneinfo, which the status page's Europe/London clock labels need; the
# plain alpine image has no tzdata at all and TimeZoneInfo throws for the zone inside it.
ARG BASE_IMAGE=mcr.microsoft.com/dotnet/aspnet:11.0-alpine-extra@sha256:e6abc337f78cea3273eb7d91fc7b2cf1360b21e928df6e5cb8a338fb1b5c6ac8
FROM ${BASE_IMAGE}

# The commit, for provenance. Everything here is fixed per commit; nothing in this file records the
# time of the build, because that is what stops one commit producing one image.
ARG GIT_COMMIT=unknown

LABEL org.opencontainers.image.title="uk.osric.asp" \
      org.opencontainers.image.source="https://github.com/Moosemorals/uk.osric.asp" \
      org.opencontainers.image.revision="${GIT_COMMIT}" \
      org.opencontainers.image.licenses="MIT"

# The base image already sets ASPNETCORE_HTTP_PORTS=8080, ASPNETCORE_ENVIRONMENT is the quadlet's
# business, and the working directory and entry point are the ones the app is built to expect.
WORKDIR /app
COPY . /app

# The base image ships this user as APP_UID; the quadlet runs as 1654:1654 for the same reason.
USER 1654
EXPOSE 8080
ENTRYPOINT ["dotnet", "/app/uk.osric.asp.Web.dll"]
