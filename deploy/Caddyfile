# Site for moosemorals.com; ACME notices go to the address below.
{
	email osric@fluffypeople.com
}

moosemorals.com {
	encode zstd gzip
	# Prometheus scrapes inside the podman network. The public origin must not serve metrics.
	@metrics path /metrics
	respond @metrics 404
	# The app trusts X-Forwarded-Proto and X-Forwarded-Host to learn the browser's scheme and host;
	# Caddy's defaults supply both, so no header directive is needed here. See deploy/README.md.
	reverse_proxy 127.0.0.1:8080
}
