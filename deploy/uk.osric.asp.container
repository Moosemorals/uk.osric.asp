[Unit]
Description=uk.osric.asp web app (rootless)
# Give up after a few rapid restarts instead of crash-looping forever; see docs/issues/OPS-02.md.
StartLimitIntervalSec=60s
StartLimitBurst=3

[Container]
ContainerName=uk.osric.asp
Image=registry.osric.uk/uk.osric.asp:latest
# Rootful Caddy cannot join a rootless podman network, so the app publishes on the host loopback
# only. Nothing outside the machine can reach it directly. Prometheus is the other rootless
# container: it reaches the app by name on the shared network, not through this published port.
Network=uk.osric.asp.network
NetworkAlias=app
PublishPort=127.0.0.1:8080:8080
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment="ConnectionStrings__Storage=Data Source=/data/storage.db"
# The image ships APP_UID 1654; inside the user namespace it maps to a subuid on the host.
User=1654:1654
Volume=uk.osric.asp-storage:/data:U
# Authentication, antiforgery and session cookies are protected with these keys. Without the volume,
# a restart signs everyone out and invalidates forms that were already open.
Volume=uk.osric.asp-keys:/home/app/.aspnet/DataProtection-Keys:U
Tmpfs=/tmp
NoNewPrivileges=true
DropCapability=all
# A page cannot be interrupted once it runs, so the container is the only thing that can stop one:
# the memory limit makes the OOM killer take this container rather than the host, and the health
# check restarts it when too many page renders have been abandoned. 2 GB is a quarter of the CAX21's
# RAM: enough for concurrent Roslyn compilations, and still leaves the page cache and the other
# units most of the box.
PodmanArgs=--memory=2g
# Equal to --memory, so the container's memory.swap.max is zero and it cannot page. On this host the
# swap file is headroom for Caddy, Prometheus and podman; a runaway page must still meet the OOM
# killer rather than thrash for minutes and take the health check's deadline with it.
PodmanArgs=--memory-swap=2g
PodmanArgs=--pids-limit=512
# The CAX21 has four vCPUs, so this leaves a whole core for Caddy and for the health check, which
# runs inside this cgroup and would otherwise starve with the page.
PodmanArgs=--cpus=3
# Longer than the host's 30 s graceful-shutdown budget, so a normal stop finishes cleanly and only a
# genuinely stuck page is SIGKILLed.
StopTimeout=35
# The liveness signal the app cannot give itself: when a page has wedged thread-pool threads, /heath
# fails and podman restarts the container. Detection plus restart is about 35 s.
HealthCmd=wget -q -O /dev/null -T 3 http://127.0.0.1:8080/heath
HealthInterval=10s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
HealthOnFailure=restart

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
# User units are pulled in by default.target; multi-user.target does not exist here.
WantedBy=default.target
