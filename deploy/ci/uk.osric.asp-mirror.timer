[Unit]
Description=Mirror the host's branches and tags to GitHub every fifteen minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=15min
# A host that was down takes the mirror when it comes back rather than waiting for the next tick.
Persistent=true
RandomizedDelaySec=30s

[Install]
WantedBy=timers.target
