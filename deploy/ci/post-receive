# Starts the check for a trunk push and the mirror for every accepted ref. The push returns as soon
# as this hook does: the check is a transient unit in the ci slice, and the mirror is a user service
# that retries by itself for ten minutes if this run fails.
set -euo pipefail

home=/home/ci
status_url=https://moosemorals.com/ci/status.json
zero=0000000000000000000000000000000000000000

if [ -z "${XDG_RUNTIME_DIR:-}" ]; then
    export XDG_RUNTIME_DIR="/run/user/$(id -u)"
fi

while read -r old new ref; do
    if [ "$ref" = "refs/heads/trunk" ] && [ "$new" != "$zero" ]; then
        short=$(printf '%s' "$new" | cut -c1-12)
        unit="uk.osric.asp-ci-$short-$$"
        systemd-run --user --no-block --collect \
            --unit="$unit" \
            --slice=uk.osric.asp-ci.slice \
            --property=Nice=10 \
            "$home/bin/check-push" "$new"
        printf 'trunk %s will be checked; the result is %s\n' "$short" "$status_url"
        printf 'the full log: journalctl _SYSTEMD_USER_UNIT=%s\n' "$unit"
    fi
done

# Every ref, including a branch or a tag, is mirrored. The service is asynchronous, and its own
# restarts are the retry: reset-failed clears the limit a previous failure reached, so this push gets
# a full window rather than inheriting an exhausted one.
systemctl --user reset-failed uk.osric.asp-mirror.service 2>/dev/null || true
if ! systemctl --user start --no-block uk.osric.asp-mirror.service; then
    echo "post-receive: could not start the mirror; check journalctl --user -u uk.osric.asp-mirror.service" >&2
fi

echo "mirroring to GitHub; a failed run retries for ten minutes, then the next push starts again"
