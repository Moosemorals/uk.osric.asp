[Slice]
# The CAX21 has four vCPUs and 8 GiB. The app keeps its own --cpus=3 and --memory=2g; this slice is
# the build's ceiling, and the low weights are what let a page win while a check is running.
CPUQuota=200%
MemoryMax=4G
CPUWeight=50
IOWeight=50
