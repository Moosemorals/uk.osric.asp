[Unit]
Description=Caddy reverse proxy
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=caddy
Image=docker.io/library/caddy:2
# Host networking lets it bind 80/443 and reach the rootless app on 127.0.0.1:8080.
Network=host
Volume=/home/deploy/caddy/Caddyfile:/etc/caddy/Caddyfile:ro
Volume=caddy-data:/data
Volume=caddy-config:/config
NoNewPrivileges=true

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
