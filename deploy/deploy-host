# The release half of `make deploy`: it pushes the image the gate built, installs the quadlets and
# the host's configuration, proves the scrapes and waits until the site answers. The target calls it
# once, after the whole gate has passed, and nothing else calls it (`code-one-gate`) — `deploy/` is
# the source of truth, so every file this installs is read from beside it.
#
# The interface is nine values, each a Makefile variable the target passes. None has a default: a
# second place a value is decided is what `deploy-quadlets-are-the-source-of-truth` exists to stop,
# and a value invented here would install a host rather than refuse.
#
#   HOST             deploy@your.server — the account the site runs as
#   SSH              the ssh command, control-socket options included
#   LOCAL_IMAGE      the tag the image was built as, on this machine
#   IMAGE_REF        the tag that follows the branch: `latest` unless the Makefile says otherwise
#   IMAGE_SHA_REF    the commit-named tag: pushed, and the one the host pulls
#   AUTHFILE         this machine's registry login
#   REMOTE_AUTHFILE  the host's registry login, which outlives a reboot
#   CI_STATUS_DIR    the directory Caddy serves /ci/status.json from
#   GIT_SHA          the commit the image is, for the last line and the upstream note
set -euo pipefail

host=${HOST:?set by make deploy}
ssh=${SSH:?set by make deploy}
local_image=${LOCAL_IMAGE:?set by make deploy}
image_ref=${IMAGE_REF:?set by make deploy}
image_sha_ref=${IMAGE_SHA_REF:?set by make deploy}
authfile=${AUTHFILE:?set by make deploy}
remote_authfile=${REMOTE_AUTHFILE:?set by make deploy}
ci_status_dir=${CI_STATUS_DIR:?set by make deploy}
git_sha=${GIT_SHA:?set by make deploy}

# The files this installs sit beside it and `git` answers about this checkout, so neither depends on
# the directory the target was run from.
deploy_dir=$(cd "$(dirname "$0")" && pwd)
cd "$(dirname "$deploy_dir")"

# ---- The host's packages -------------------------------------------------------------------------
#
# A host that predates cloud-init's packages needs them before anything else. The backup host pulls
# with rsync, which runs a copy on this host as the remote side. nft is the ban action's own command
# and lives in /usr/sbin, which is not on the PATH an ssh command runs with, so it is named in full
# rather than looked up: a jail without it installs, starts and silently fails to ban. Each missing
# piece is named, because "missing fail2ban or nftables" sends an operator to apt for packages that
# are already there.

$ssh "$host" 'dpkg -s aardvark-dns >/dev/null 2>&1 || {
	echo "the host is missing aardvark-dns: container names will not resolve";
	echo "run: sudo apt-get install -y aardvark-dns";
	exit 1; }'

$ssh "$host" 'command -v rsync >/dev/null 2>&1 || {
	echo "the host is missing rsync: the backup host cannot copy its snapshots";
	echo "run: sudo apt-get install -y rsync";
	exit 1; }'

$ssh "$host" 'missing=;
	dpkg -s fail2ban >/dev/null 2>&1 || missing="$missing fail2ban";
	dpkg -s nftables >/dev/null 2>&1 || missing="$missing nftables";
	test -x /usr/sbin/nft || missing="$missing /usr/sbin/nft";
	if [ -n "$missing" ]; then
		echo "the host is missing${missing}: nothing will ban an address that keeps failing to sign in";
		echo "run: sudo apt-get install -y fail2ban nftables jq";
		exit 1;
	fi'

# ---- The image -----------------------------------------------------------------------------------
#
# Two tags move the image the gate built to the registry, and the host pulls the commit-named one: a
# tag that names the commit is the only thing a rollback can rely on.

podman tag "$local_image" "$image_ref"
podman tag "$local_image" "$image_sha_ref"
podman push --authfile "$authfile" "$image_ref"
podman push --authfile "$authfile" "$image_sha_ref"
$ssh "$host" podman pull --authfile "$remote_authfile" "$image_sha_ref"

# ---- The app's own paths -------------------------------------------------------------------------
#
# The assistant's EnvironmentFile has no optional form in podman: quadlet turns it into
# `podman run --env-file`, which has no `-` form and fails the container when the path is absent.
# Seed it once so the path exists; it must hold Assistant__ApiKey, because the host refuses to start
# without one. `test -e` leaves the secret alone.
#
# The settings override is the same shape of problem: a single-file bind of a missing path becomes a
# directory and the app cannot read it. Seed it once with an empty object, which merges over the
# shipped section and changes nothing, and leave a host's own file alone.

$ssh "$host" 'install -d -m 0700 .config/uk.osric.asp; test -e .config/uk.osric.asp/assistant.env || install -m 0600 /dev/null .config/uk.osric.asp/assistant.env'
$ssh "$host" 'test -e .config/uk.osric.asp/appsettings.Production.json || echo "{}" > .config/uk.osric.asp/appsettings.Production.json'
$ssh "$host" install -d .config/prometheus

# ---- The rootless units --------------------------------------------------------------------------
#
# The quadlets are the source of truth and the Image= line is rewritten on the way, so REGISTRY and
# the commit tag reach the host. Every one is written before the single daemon-reload that reads
# them, and both services are restarted in one command afterwards: a reload or a restart each costs a
# round trip, and neither has anything to do until the last file is in place. Restarting rather than
# starting is what makes a Caddyfile edit take effect on a redeploy. There is no enable step for the
# quadlets: quadlet units are transient, so systemctl refuses to enable them, and the generator
# already applies each quadlet's [Install] section on daemon-reload.

$ssh "$host" 'cat > .config/containers/systemd/uk.osric.asp.network' < "$deploy_dir/uk.osric.asp.network"
sed "s|^Image=.*|Image=$image_sha_ref|" "$deploy_dir/uk.osric.asp.container" | $ssh "$host" 'cat > .config/containers/systemd/uk.osric.asp.container'
$ssh "$host" 'cat > .config/prometheus/prometheus.yml' < "$deploy_dir/prometheus.yml"
$ssh "$host" 'cat > .config/containers/systemd/prometheus.container' < "$deploy_dir/prometheus.container"
$ssh "$host" 'cat > .config/containers/systemd/node-exporter.container' < "$deploy_dir/node-exporter.container"

# node_exporter serves this directory and nothing else; the root timer below fills it. It has to
# exist before the container starts, and the files in it are 0644 so the image's nobody can read
# them from inside a rootless container.
$ssh "$host" sudo install -d -o root -g root -m 0755 /var/lib/node-exporter/textfile

# The snapshot script and its clock live on the host like the quadlets do. The pull is the backup
# host's job and runs from its own copy of deploy/pull-backups.sh, so nothing here reaches it.
$ssh "$host" install -d bin
$ssh "$host" 'cat > bin/backup-snapshot.sh' < "$deploy_dir/backup-snapshot.sh"
$ssh "$host" chmod 0755 bin/backup-snapshot.sh
$ssh "$host" install -d .config/systemd/user
$ssh "$host" 'cat > .config/systemd/user/uk.osric.asp-backup.service' < "$deploy_dir/uk.osric.asp-backup.service"
$ssh "$host" 'cat > .config/systemd/user/uk.osric.asp-backup.timer' < "$deploy_dir/uk.osric.asp-backup.timer"
$ssh "$host" systemctl --user daemon-reload
$ssh "$host" systemctl --user restart uk.osric.asp.service prometheus.service node-exporter.service
$ssh "$host" systemctl --user enable --now uk.osric.asp-backup.timer

# ---- The first wait ------------------------------------------------------------------------------

# Prometheus scrapes the app by name on the containers' own network, so this proves the network and
# the app's loopback-facing port at once.
$ssh "$host" 'i=0; until podman exec prometheus wget -qO- -T 3 http://app:8080/health >/dev/null 2>&1; do
	i=$((i+1));
	if [ $i -ge 10 ]; then
		echo "Prometheus cannot reach the app at app:8080: check podman network inspect uk.osric.asp";
		exit 1;
	fi;
	sleep 2;
done'

# ---- The CI status seed --------------------------------------------------------------------------
#
# The status is Caddy's, not the app's: the caddy container mounts this directory, so it must exist
# before that unit starts. Seed a valid never-run body rather than a 404; ci-install owns it and
# leaves an existing result alone.

$ssh "$host" 'sudo install -d -m 0755 '"$ci_status_dir"';
	if id ci >/dev/null 2>&1; then sudo chown ci:ci '"$ci_status_dir"'; fi;
	if [ ! -e '"$ci_status_dir"'/status.json ]; then
		if id ci >/dev/null 2>&1; then
			sudo -H -u ci tee '"$ci_status_dir"'/status.json >/dev/null;
		else
			sudo tee '"$ci_status_dir"'/status.json >/dev/null;
		fi;
		sudo chmod 0644 '"$ci_status_dir"'/status.json;
	fi;
	if id ci >/dev/null 2>&1; then sudo chown ci:ci '"$ci_status_dir"'/status.json; fi' < "$deploy_dir/ci/status-never-run.json"

# ---- The rootful units ---------------------------------------------------------------------------
#
# Caddy is the only rootful unit. The ban's one jail and its filter live here like the quadlets and
# the Caddyfile do: installing them beside the app's restart keeps the words the app logs and the
# words fail2ban matches in one commit, and the reload re-reads both without losing the rest of the
# host's state.

$ssh "$host" sudo install -d -o root -g root -m 0755 /etc/caddy
$ssh "$host" 'sudo tee /etc/caddy/Caddyfile > /dev/null' < "$deploy_dir/Caddyfile"
$ssh "$host" 'sudo tee /etc/containers/systemd/caddy.container' < "$deploy_dir/caddy.container" > /dev/null
$ssh "$host" sudo systemctl daemon-reload
$ssh "$host" sudo systemctl restart caddy.service
$ssh "$host" 'sudo tee /etc/fail2ban/filter.d/uk.osric.asp.conf > /dev/null' < "$deploy_dir/fail2ban/filter.d/uk.osric.asp.conf"
$ssh "$host" 'sudo tee /etc/fail2ban/jail.local > /dev/null' < "$deploy_dir/fail2ban/jail.local"
$ssh "$host" sudo systemctl enable fail2ban.service
$ssh "$host" sudo systemctl reload-or-restart fail2ban.service

# ---- The metrics collector -----------------------------------------------------------------------
#
# fail2ban's numbers, for the status page's Host group. The collector is root's because the socket
# is; node_exporter was restarted above and picks the file up on its next scrape. The service is
# started once here as well as by the timer, so a fresh host has numbers before the first tick.

$ssh "$host" 'sudo tee /usr/local/sbin/uk.osric.asp-fail2ban-metrics > /dev/null' < "$deploy_dir/fail2ban-metrics.sh"
$ssh "$host" sudo chmod 0755 /usr/local/sbin/uk.osric.asp-fail2ban-metrics
$ssh "$host" 'sudo tee /etc/systemd/system/uk.osric.asp-fail2ban-metrics.service > /dev/null' < "$deploy_dir/uk.osric.asp-fail2ban-metrics.service"
$ssh "$host" 'sudo tee /etc/systemd/system/uk.osric.asp-fail2ban-metrics.timer > /dev/null' < "$deploy_dir/uk.osric.asp-fail2ban-metrics.timer"
$ssh "$host" sudo systemctl daemon-reload
$ssh "$host" sudo systemctl start uk.osric.asp-fail2ban-metrics.service
$ssh "$host" sudo systemctl enable --now uk.osric.asp-fail2ban-metrics.timer

# ---- The scrape and the health -------------------------------------------------------------------

# The scrape path end to end: the container must resolve by name on the network and the file must
# parse, or the Host panels are silently empty.
$ssh "$host" 'i=0; until podman exec prometheus wget -qO- -T 3 http://node-exporter:9100/metrics 2>/dev/null | grep -q "^fail2ban_jail_banned_current"; do
	i=$((i+1));
	if [ $i -ge 15 ]; then
		echo "Prometheus cannot read the fail2ban metrics from node-exporter:9100: check systemctl status uk.osric.asp-fail2ban-metrics.service and /var/lib/node-exporter/textfile";
		exit 1;
	fi;
	sleep 2;
done'

echo "waiting for /health"
$ssh "$host" 'i=0; until curl -fsS -o /dev/null http://127.0.0.1:8080/health; do
	i=$((i+1));
	if [ $i -ge 30 ]; then
		echo "the site is not healthy 60s after the restart: journalctl --user -u uk.osric.asp.service";
		exit 1;
	fi;
	sleep 2;
done'

# ---- What it says --------------------------------------------------------------------------------

echo "deployed $git_sha"

# The image is tagged with the commit, so a commit that reached the registry but never reached the
# remote leaves the running site with no source anyone else can fetch, review, or rebuild a rollback
# from. A note rather than a gate: the push has already happened and cannot be withdrawn, so failing
# here would only make a successful deploy look like a failed one.
if up=$(git rev-parse --abbrev-ref --symbolic-full-name '@{u}' 2>/dev/null); then
	ahead=$(git rev-list --count "$up..HEAD");
	if [ "$ahead" -gt 0 ]; then
		echo "but $up is missing $ahead commit(s): git push";
		git --no-pager log --oneline "$up..HEAD";
	fi;
else
	echo "but this checkout has no upstream to compare $git_sha with: is the commit on the remote?";
fi
