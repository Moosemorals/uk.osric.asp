#
# The host's only fail2ban jail. `make deploy` installs this file to /etc/fail2ban/jail.local and
# the filter beside it; deploy/ is the source of truth for the host, never the copy on it.
#
# Debian ships dozens of jails and enables sshd's, and none of the rest is wanted here: this host is
# reached through Caddy, and a scanner that reads logs nobody writes is a service pretending to
# work. The one thing worth banning is an address that keeps failing this site's authentication,
# which is what the jail below does and the only jail that is on.

[DEFAULT]
# Every port, not the one a jail names: the address is being stopped, not reasoned with. Debian's
# action is nftables, which writes its own table and hooks input ahead of ufw's chains, so the two
# firewalls do not have to agree about anything.
banaction = nftables[type=allports]

# The host's own addresses are never banned, including the loopback the app is published on.
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled = false

[uk.osric.asp]
enabled = true
filter = uk.osric.asp
# The app is a user unit, and the container's output is the unit's, so its lines are in the user
# journal and not in a file. The backend has to be told where the journal is: its default opens the
# system journal alone, and journald keeps a user's entries in user-<uid>.journal, so the app is
# invisible to it and the jail counts nothing but looks healthy. The directory is the journal root
# rather than a file, so rotation and a new boot's files are picked up, and the matches below narrow
# it back to this unit, since the path opens every user's journal too. The container name is matched
# as well, so an entry is found whichever way podman attaches it.
backend = systemd[journalpath="/var/log/journal"]
journalmatch = _SYSTEMD_USER_UNIT=uk.osric.asp.service
              CONTAINER_NAME=uk.osric.asp
# Ten refusals inside a minute is a client that is not going to succeed, and an hour is long enough
# to be worth having. The sign-in throttle already permits ten attempts in the same minute, so a
# password guesser meets the ban at the throttle's own limit; everything else - a stale token, a
# page's sign-in redirect - is not throttled at all and meets it at ten requests.
maxretry = 10
findtime = 1m
bantime = 1h
