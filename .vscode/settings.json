{
  // Name the solution so the language server always loads the project graph; without it the files
  // are analysed project-less, with no implicit usings and no analyzers.
  "dotnet.defaultSolution": "uk.osric.asp.slnx",
  // Build output lives here and is regenerated by `make build`. Excluding it keeps the generated
  // sources under artifacts/obj out of the explorer, the search results and the language server.
  "files.exclude": {
    "**/artifacts": true
  },
  "search.exclude": {
    "**/artifacts": true
  },
  // The seeded pages are served under their file name, so they have no extension and need a path
  // association. A glob beats an extension association and the longest glob wins, so the assets in
  // the same folder are listed too; without them `site.css` would become a template.
  "files.associations": {
    "**/Pages/Seeds/*": "asp",
    "**/Pages/Seeds/*.css": "css",
    "**/Pages/Seeds/*.js": "javascript",
    "**/Pages/Seeds/*.svg": "xml"
  }
}
