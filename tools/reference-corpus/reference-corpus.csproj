<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tool is not a document; nothing binds to it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The assembly list and the model the site reads are shared by link, so the build emits
         exactly the shape the site deserialises. -->
    <Compile Include="../../src/uk.osric.asp.Web/Documentation/ReferenceAssemblyInfo.cs" Link="Corpus/ReferenceAssemblyInfo.cs" />
    <Compile Include="../../src/uk.osric.asp.Web/Documentation/ReferenceModel.cs" Link="Corpus/ReferenceModel.cs" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus is written with the same serializer settings the site reads it with. -->
    <ProjectReference Include="../../src/uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
  </ItemGroup>

</Project>
