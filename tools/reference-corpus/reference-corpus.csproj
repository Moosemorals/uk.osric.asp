<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- The tool is not a document; nothing binds to it. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- The model the site reads is the page contract's, so the build emits exactly the shape the
         site deserialises and neither project keeps a second copy. -->
    <ProjectReference Include="../../src/uk.osric.asp.Sdk/uk.osric.asp.Sdk.csproj" />
    <!-- The corpus is written with the same serializer settings the site reads it with. -->
    <ProjectReference Include="../../src/uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
  </ItemGroup>

</Project>
