{
  "name": "asp-template-language",
  "displayName": "uk.osric.asp template",
  "description": "HTML outside <% %> and C# inside it, for a uk.osric.asp page template.",
  "version": "0.1.0",
  "publisher": "uk-osric-asp",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "icon": "./icon.png",
  "contributes": {
    "languages": [
      {
        "id": "asp",
        "aliases": [
          "ASP template",
          "asp"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "asp",
        "scopeName": "text.html.asp",
        "path": "./syntaxes/asp.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.asp": "csharp"
        }
      },
      {
        "scopeName": "asp.injection.html",
        "path": "./syntaxes/asp-injection.tmLanguage.json",
        "injectTo": [
          "text.html.asp"
        ]
      }
    ],
    "configuration": {
      "title": "uk.osric.asp template",
      "properties": {
        "aspLanguageServer.command": {
          "type": "string",
          "default": "dotnet",
          "description": "The command that runs the language server, usually dotnet."
        },
        "aspLanguageServer.path": {
          "type": "string",
          "default": "${workspaceFolder}/artifacts/bin/asp-language-server/debug/asp-language-server.dll",
          "description": "The built server the command runs. `make build` puts it here."
        },
        "aspLanguageServer.seeds": {
          "type": "string",
          "default": "${workspaceFolder}/src/uk.osric.asp.Web/Pages/Seeds",
          "description": "The seed folder the server compiles a page against, standing in for the page store."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:asp"
  ],
  "extensionKind": [
    "workspace"
  ]
}
