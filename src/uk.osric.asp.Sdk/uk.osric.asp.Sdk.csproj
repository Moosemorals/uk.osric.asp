<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The page contract: the only assembly a compiled page binds against, and the only one the page
    policy lets it name. Reference-free on purpose, so nothing it exposes can drag the host in.
  -->

  <ItemGroup>
    <!-- The page contract is the one surface that must stay open, so it is declared shipped in full:
         widening it is a deliberate edit to this file, not an accident. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
    <AdditionalFiles Include="PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="PublicAPI.Unshipped.txt" />
  </ItemGroup>

</Project>
