<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The page contract: the only assembly a compiled page binds against, and the only one the page
    policy lets it name. Reference-free on purpose, so nothing it exposes can drag the host in.
  -->

  <ItemGroup>
    <!-- The page contract is the one surface that must stay open, so it is declared shipped in full:
         widening it is a deliberate edit to this file, not an accident. The package adds the two files
         beside this project as AdditionalFiles itself, so they are not listed here: listing them
         again makes `dotnet format` warn that each is a duplicate source file. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

</Project>
