<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Acornima" />
    <PackageReference Include="Markdig" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
    <ProjectReference Include="../uk.osric.asp.Sdk/uk.osric.asp.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build says what this assembly publishes: a new public symbol is an error until it is
         declared, and a removed one is an error until its line goes. The package adds the two files
         beside this project as AdditionalFiles itself, so they are not listed here: listing them
         again makes `dotnet format` warn that each is a duplicate source file. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="uk.osric.asp.Runtime.Tests" />
    <InternalsVisibleTo Include="uk.osric.asp.Web.Tests" />
  </ItemGroup>

</Project>
