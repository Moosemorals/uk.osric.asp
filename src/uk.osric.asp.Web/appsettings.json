{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Pages": {
    "ReservedPaths": [ "/edit", "/site.css", "/favicon.ico", "/heath", "/login", "/logout" ],
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
