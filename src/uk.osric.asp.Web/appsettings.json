{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Metrics": {
    "PrometheusUrl": "http://prometheus:9090",
    "TimeZone": "Europe/London"
  },
  "Admin": {
    "Changelist": "changes.txt"
  },
  "Assistant": {
    "Enabled": false,
    "BaseUrl": "https://api.deepseek.com",
    "ChatCompletionsPath": "/chat/completions",
    "Model": "deepseek-flash",
    "ReasoningField": "reasoning_content",
    "RequireApiKey": true,
    "AllowInsecureHttp": false,
    "Temperature": 0.2,
    "MaxOutputTokens": 393216,
    "IncludeUsage": true,
    "MaxSteps": 160,
    "MaxToolCalls": 128,
    "MaxToolCallsPerStep": 8,
    "MaxActiveRuns": 2,
    "MaxQueuedRuns": 8,
    "RequestTimeoutSeconds": 120,
    "RunTimeoutSeconds": 120,
    "ToolTimeoutSeconds": 10,
    "BalanceTimeoutSeconds": 3,
    "MaxProviderRetries": 1,
    "MaxMessageChars": 16384,
    "MaxPageChars": 262144,
    "MaxToolArgumentChars": 131072,
    "MaxToolResultChars": 131072,
    "MaxContextTokens": 500000,
    "ModelContextTokens": 1048576,
    "MaxMemoriesPerOwner": 200,
    "MaxMemoryChars": 1000,
    "MaxMemoriesPerRun": 12,
    "MaxMemoryCharsPerRun": 4000,
    "MaxMemorySearchResults": 50,
    "MaxMemoryQueryTerms": 12,
    "HeartbeatSeconds": 15,
    "JournalMaxEvents": 20000,
    "JournalMaxBytes": 4194304,
    "JournalTtlMinutes": 10,
    "WritablePathPrefix": ""
  },
  "Pages": {
    "Layout": "/_layout",
    "Editor": { "Key": "/pages" },
    "ReservedPaths": [ "/admin/changes", "/admin/export", "/admin/import", "/admin/restore", "/admin/scrub", "/assistant", "/favicon.ico", "/heath", "/login", "/logout", "/metrics", "/status" ],
    "ContentTypes": {
      "Fallback": { "ContentType": "text/html; charset=utf-8", "ScriptPolicy": "none" },
      "Extensions": {
        ".html": { "ContentType": "text/html; charset=utf-8", "ScriptPolicy": "none" },
        ".js": { "ContentType": "text/javascript; charset=utf-8", "ScriptPolicy": "none" },
        ".mjs": { "ContentType": "text/javascript; charset=utf-8", "ScriptPolicy": "none" },
        ".css": { "ContentType": "text/css; charset=utf-8", "ScriptPolicy": "none" },
        ".json": { "ContentType": "application/json; charset=utf-8", "ScriptPolicy": "none" },
        ".svg": { "ContentType": "image/svg+xml; charset=utf-8", "ScriptPolicy": "none" },
        ".txt": { "ContentType": "text/plain; charset=utf-8", "ScriptPolicy": "none" }
      }
    },
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2,
      "MaxLayoutDepth": 4
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 5
    },
    "Storage": {
      "MaxKeyChars": 200,
      "MaxValueBytes": 65536,
      "MaxKeysPerPage": 256,
      "MaxPageBytes": 262144,
      "CommandTimeoutSeconds": 5
    },
    "Fetch": {
      "TimeoutSeconds": 4,
      "MaxResponseBytes": 1048576,
      "MaxRequestsPerRender": 10,
      "MaxRedirects": 3,
      "Credentials": {}
    },
    "Read": {
      "MaxRowsPerList": 500,
      "MaxSourceCharsPerRender": 524288
    },
    "Session": {
      "CommandTimeoutSeconds": 5,
      "MaxLiveSessions": 2048,
      "Anonymous": {
        "MaxValueBytes": 4096,
        "MaxKeys": 8,
        "MaxTotalBytes": 16384,
        "IdleMinutes": 30
      },
      "SignedIn": {
        "MaxValueBytes": 16384,
        "MaxKeys": 32,
        "MaxTotalBytes": 65536,
        "IdleMinutes": 480
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "uk.osric.asp": "Information"
    }
  },
  "AllowedHosts": "*"
}
