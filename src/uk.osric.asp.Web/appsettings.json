{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Metrics": {
    "PrometheusUrl": "http://prometheus:9090",
    "TimeZone": "Europe/London"
  },
  "Assistant": {
    "Enabled": false,
    "BaseUrl": "https://api.deepseek.com",
    "ChatCompletionsPath": "/chat/completions",
    "Model": "deepseek-flash",
    "ReasoningField": "reasoning_content",
    "RequireApiKey": true,
    "AllowInsecureHttp": false,
    "Temperature": 0.2,
    "MaxOutputTokens": 32768,
    "IncludeUsage": true,
    "MaxSteps": 512,
    "MaxToolCalls": 1024,
    "MaxToolCallsPerStep": 32,
    "MaxActiveRuns": 2,
    "MaxQueuedRuns": 8,
    "RequestTimeoutSeconds": 300,
    "RunTimeoutSeconds": 300,
    "ToolTimeoutSeconds": 30,
    "MaxProviderRetries": 1,
    "MaxMessageChars": 16384,
    "MaxPageChars": 262144,
    "MaxToolArgumentChars": 131072,
    "MaxToolResultChars": 32768,
    "MaxContextChars": 120000,
    "HeartbeatSeconds": 15,
    "JournalMaxEvents": 20000,
    "JournalMaxBytes": 4194304,
    "JournalTtlMinutes": 10,
    "ProtectedPaths": [
      "/admin.js", "/admin.css", "/assistant.js", "/assistant.css", "/editor.js", "/editor.css",
      "/layout.css", "/site.css", "/status.css", "/rocket.svg"
    ],
    "WritablePathPrefix": ""
  },
  "Pages": {
    "ReservedPaths": [ "/admin", "/assistant", "/edit", "/favicon.ico", "/heath", "/login", "/logout", "/metrics", "/status" ],
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 10
    },
    "Storage": {
      "MaxKeyChars": 200,
      "MaxValueBytes": 65536,
      "MaxKeysPerPage": 256,
      "MaxPageBytes": 262144,
      "CommandTimeoutSeconds": 5
    },
    "Fetch": {
      "AllowedHosts": [],
      "TimeoutSeconds": 4,
      "MaxResponseBytes": 1048576,
      "MaxRequestsPerRender": 10,
      "MaxRedirects": 3
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "uk.osric.asp": "Information"
    }
  },
  "AllowedHosts": "*"
}
