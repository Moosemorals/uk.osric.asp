{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Metrics": {
    "PrometheusUrl": "http://prometheus:9090",
    "TimeZone": "Europe/London",
    "QueryTimeoutSeconds": 2,
    "CacheSeconds": 15,
    "MaxCachedWindows": 16
  },
  "Admin": {
    "Changelist": "changes.txt"
  },
  "Assistant": {
    "BaseUrl": "https://api.deepseek.com",
    "ChatCompletionsPath": "/chat/completions",
    "Model": "deepseek-flash",
    "ModelsPath": "/models",
    "ModelsTimeoutSeconds": 3,
    "ReasoningField": "reasoning_content",
    "RequireApiKey": true,
    "AllowInsecureHttp": false,
    "Temperature": 0.2,
    "MinOutputTokens": 131072,
    "MaxSteps": 160,
    "MaxToolCalls": 128,
    "MaxToolCallsPerStep": 64,
    "MaxActiveRuns": 2,
    "MaxQueuedRuns": 8,
    "RequestTimeoutSeconds": 120,
    "RunTimeoutSeconds": 120,
    "ToolTimeoutSeconds": 10,
    "BalanceTimeoutSeconds": 3,
    "BalanceSampleSeconds": 60,
    "MaxProviderRetries": 1,
    "MaxPageChars": 262144,
    "MaxToolArgumentChars": 270336,
    "MaxMemoriesPerOwner": 200,
    "MaxMemoryChars": 1000,
    "MaxMemorySearchResults": 50,
    "MaxMemoryQueryTerms": 12,
    "MaxQuestionsPerCall": 4,
    "MaxQuestionOptions": 5,
    "MaxQuestionChars": 500,
    "HeartbeatSeconds": 15,
    "JournalMaxEvents": 20000,
    "JournalMaxBytes": 4194304,
    "JournalTtlMinutes": 10,
    "WritablePathPrefix": "",
    "MaxSearchMatches": 1000,
    "DefaultListLimit": 50,
    "MaxListLimit": 500,
    "ShellMatchLimit": 100,
    "ShellDefaultLines": 10,
    "MaxCheckDiagnostics": 100
  },
  "Pages": {
    "Layout": "/_layout",
    "Editor": {
      "Key": "/pages"
    },
    "Archive": {
      "MaxUploadBytes": 16777216,
      "MaxPages": 500,
      "MaxCompiledBytes": 134217728,
      "StageTtlMinutes": 30,
      "MaxStagedImports": 3
    },
    "ContentTypes": {
      "Fallback": {
        "ContentType": "text/html; charset=utf-8",
        "ScriptPolicy": "none"
      },
      "Extensions": {
        ".html": {
          "ContentType": "text/html; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".js": {
          "ContentType": "text/javascript; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".mjs": {
          "ContentType": "text/javascript; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".css": {
          "ContentType": "text/css; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".json": {
          "ContentType": "application/json; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".svg": {
          "ContentType": "image/svg+xml; charset=utf-8",
          "ScriptPolicy": "none"
        },
        ".txt": {
          "ContentType": "text/plain; charset=utf-8",
          "ScriptPolicy": "none"
        }
      }
    },
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2,
      "MaxLayoutDepth": 4,
      "MaxEmbedDepth": 4,
      "MaxEmbeds": 32
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 5
    },
    "Stream": {
      "Slots": 8,
      "SilenceSeconds": 60,
      "MaxSeconds": 1800
    },
    "Jobs": {
      "QueueCapacity": 8,
      "MaxConcurrent": 2,
      "SilenceSeconds": 120,
      "MaxDurationSeconds": 32400,
      "MaxEvents": 512,
      "MaxEventBytes": 262144,
      "RetentionMinutes": 30,
      "MaxWaitSeconds": 30,
      "MaxMessageBytes": 16384,
      "MaxPendingMessages": 32
    },
    "Stores": {
      "MaxKeyChars": 200,
      "CommandTimeoutSeconds": 5,
      "BusyTimeoutSeconds": 5,
      "Page": {
        "MaxValueBytes": 65536,
        "MaxKeys": 256,
        "MaxTotalBytes": 262144
      },
      "Visitor": {
        "Anonymous": {
          "MaxValueBytes": 4096,
          "MaxKeys": 8,
          "MaxTotalBytes": 16384,
          "IdleMinutes": 30
        },
        "Browser": {
          "MaxValueBytes": 4096,
          "MaxKeys": 8,
          "MaxTotalBytes": 16384,
          "LifetimeDays": 365
        },
        "SignedIn": {
          "MaxValueBytes": 16384,
          "MaxKeys": 32,
          "MaxTotalBytes": 65536
        },
        "MaxLiveSessions": 2048
      },
      "Records": {
        "MaxTablesPerSource": 8,
        "MaxColumnsPerTable": 24,
        "MaxNameChars": 64,
        "MaxRowsPerSubject": 10000,
        "MaxBytesPerSubject": 67108864,
        "MaxResultRows": 500,
        "MaxResultChars": 262144,
        "StatementMaxSeconds": 5,
        "TransactionMaxSeconds": 10
      }
    },
    "Fetch": {
      "TimeoutSeconds": 4,
      "MaxResponseBytes": 1048576,
      "StreamSilenceSeconds": 30,
      "StreamMaxSeconds": 600,
      "MaxStreamBytes": 4194304,
      "MaxRequestsPerRender": 10,
      "MaxRedirects": 3,
      "Credentials": {}
    },
    "Read": {
      "MaxRowsPerList": 500,
      "MaxSourceCharsPerRender": 524288
    },
    "Search": {
      "MaxDurationMs": 30,
      "DefaultMatches": 100,
      "MaxMatches": 1000,
      "DefaultContextChars": 64,
      "MaxContextChars": 1024
    }
  },
  "Site": {
    "Origin": "http://127.0.0.1:8080"
  },
  "Authentication": {
    "TicketLifetimeDays": 30,
    "Login": {
      "PermitLimit": 10,
      "WindowSeconds": 60
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "uk.osric.asp": "Information"
    }
  },
  "AllowedHosts": "*"
}
