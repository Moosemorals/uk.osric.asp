{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Metrics": {
    "PrometheusUrl": "http://prometheus:9090",
    "TimeZone": "Europe/London"
  },
  "Agent": {
    "Enabled": false,
    "Provider": "deepseek",
    "BaseUrl": "https://api.deepseek.com",
    "ChatCompletionsPath": "/chat/completions",
    "Model": "deepseek-flash",
    "ReasoningField": "reasoning_content",
    "RequireApiKey": true,
    "AllowInsecureHttp": false,
    "Temperature": 0.2,
    "MaxOutputTokens": 4096,
    "IncludeUsage": true,
    "MaxSteps": 12,
    "MaxToolCalls": 32,
    "MaxToolCallsPerStep": 8,
    "MaxActiveRuns": 2,
    "MaxQueuedRuns": 8,
    "RequestTimeoutSeconds": 300,
    "RunTimeoutSeconds": 600,
    "ToolTimeoutSeconds": 30,
    "MaxProviderRetries": 1,
    "MaxMessageChars": 16384,
    "MaxPageChars": 262144,
    "MaxToolArgumentChars": 131072,
    "MaxToolResultChars": 32768,
    "MaxContextChars": 120000,
    "HeartbeatSeconds": 15,
    "JournalMaxEvents": 20000,
    "JournalMaxBytes": 4194304,
    "JournalTtlMinutes": 10,
    "ProtectedPaths": [
      "/assistant.js", "/assistant.css", "/editor.js", "/editor.css",
      "/layout.css", "/site.css", "/status.css", "/rocket.svg"
    ],
    "WritablePathPrefix": ""
  },
  "Pages": {
    "ReservedPaths": [ "/admin", "/assistant", "/edit", "/favicon.ico", "/heath", "/login", "/logout", "/metrics", "/status" ],
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "uk.osric.asp": "Information"
    }
  },
  "AllowedHosts": "*"
}
