{
  "ConnectionStrings": {
    "Storage": "Data Source=data/storage.db"
  },
  "Metrics": {
    "PrometheusUrl": "http://prometheus:9090",
    "TimeZone": "Europe/London"
  },
  "Pages": {
    "ReservedPaths": [ "/admin", "/edit", "/favicon.ico", "/heath", "/login", "/logout", "/metrics", "/status" ],
    "Render": {
      "TimeoutSeconds": 5,
      "Slots": 2,
      "MaxBodyChars": 4194304,
      "AbandonedLimit": 2
    },
    "Compile": {
      "Slots": 1,
      "TimeoutSeconds": 10
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "uk.osric.asp": "Information"
    }
  },
  "AllowedHosts": "*"
}
