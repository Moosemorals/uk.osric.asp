@model uk.osric.asp.Core.IContext

@if (Model.BuildResult?.Success == true) {
    <p>Compilation succeeded!</p>
} else {
    <p>Compilation failed.</p>
    <ul>
        @foreach (var diagnostic in Model.BuildResult?.Diagnostics ?? []) {
            <li>@diagnostic</li>
        }
    </ul>
}