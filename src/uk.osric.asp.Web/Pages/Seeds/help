<% ctx.Capabilities.GetRequired<IPageLayout>().Title = "Help"; %>
<h1>Help</h1>
<p>This is the author manual. It is itself a stored page, so logged in users
can improve it at <a href="/edit/help">/edit/help</a>.</p>

<nav aria-label="Help contents">
    <h2>Contents</h2>
    <ul>
