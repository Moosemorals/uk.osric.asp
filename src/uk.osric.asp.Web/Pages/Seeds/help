<% ctx.Capabilities.GetRequired<IPageLayout>().Title = "Help";
   ctx.Capabilities.GetRequired<IPageComposition>().Wrap(); %>
<h1>Help</h1>
<p>This is the author manual. It is itself a stored page, so logged in users
can improve it at <a href="<%= ctx.EditorPath %>?edit=<%= System.Uri.EscapeDataString(ctx.Path) %>"><%= ctx.EditorPath %>?edit=<%= ctx.Path %></a>.</p>

