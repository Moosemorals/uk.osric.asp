   ctx.Features.GetRequired<IPageLayout>().Title = "About"; %>
<h1>About</h1>
<p><strong>uk.osric.asp</strong> is a small web server whose pages are C# and can edit themselves.
Every page is a row in SQLite, compiled with Roslyn when it is saved, and the site ships with an
editor, a Markdown renderer, a status dashboard and an optional AI assistant.</p>
<% if (ctx.Features.GetRequired<IBuildInfo>().Commit is { } commit) { %>
<p>This site is running commit <a href="https://github.com/Moosemorals/uk.osric.asp/commit/<%= commit %>"><code><%= commit %></code></a>.</p>
<% } else { %>
<p>This site is running a build that does not record its commit.</p>
<% } %>

<h2>Credits</h2>
<ul>
    <li><strong>Osric Wilkinson</strong> — author, designer and maintainer.</li>
    <li><strong>DeepSeek</strong> — AI pair programmer. Much of the code, tests and documentation
    was written with DeepSeek in the loop, and DeepSeek is the model behind the optional
    assistant.</li>
</ul>

