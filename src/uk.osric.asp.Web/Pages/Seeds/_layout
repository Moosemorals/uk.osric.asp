<%! using Site.Document; %><% var layout = ctx.Capabilities.GetRequired<IPageLayout>();
   bool At(string href) => ctx.Request.Path == href;
   bool Under(string href) => At(href) || ctx.Request.Path.StartsWith(href + "/", System.StringComparison.Ordinal);
   var links = new System.Collections.Generic.List<NavLink> {
       new("/", "Home", At("/")),
   };
   if (ctx.User is null) {
       links.Add(new("/login", "Sign in", At("/login")));
   } else {
       links.Add(new("/assistant", "Assistant", Under("/assistant")));
       links.Add(new(ctx.EditorPath, "Pages", Under(ctx.EditorPath)));
       links.Add(new("/admin", "Admin", Under("/admin")));
       links.Add(new("/logout", "Sign out", At("/logout")));
   }
   // The wrapper owns the document, so it folds the page's title, head and sheets itself. Asking for
   // this page directly has no content to fold, which is why the merge names the site's own title.
   Document.Head(ctx, layout, "Site", ctx.AssetUrl);
   Document.Banner(ctx, "Site", links, "site-nav");
   Document.OpenMain(ctx); %>
<%== layout.Content?.Body ?? "" %>
<footer><% Document.Nav(ctx, "Footer",
    new System.Collections.Generic.List<NavLink> {
        new("/about", "About", false),
        new("/privacy", "Privacy policy", false),
    }, "site-footer"); %></footer>
<% Document.CloseMain(ctx);
   Document.End(ctx); %>
