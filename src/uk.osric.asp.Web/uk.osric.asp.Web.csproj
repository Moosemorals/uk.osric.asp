<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Built with the SDK's container support (make image). The base image and tag come from the
         Makefile; the user is the non-root account the base image creates. -->
    <ContainerRepository>uk.osric.asp</ContainerRepository>
    <ContainerUser>1654</ContainerUser>
    <ContainerTitle>uk.osric.asp</ContainerTitle>
    <ContainerDescription>A web server whose pages are C# and can edit themselves.</ContainerDescription>
    <ContainerInformationUrl>https://github.com/Moosemorals/uk.osric.asp</ContainerInformationUrl>
    <ContainerLicenseExpression>MIT</ContainerLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ContainerLabel Include="org.opencontainers.image.revision" Value="$(GIT_COMMIT)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Metrics only: the exporter serves /metrics, and the hosting package registers the provider. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <!-- Pinned directly for sqlite3_serialize/sqlite3_deserialize, which sit below the ADO.NET
         provider. The same version Microsoft.EntityFrameworkCore.Sqlite already resolves. -->
    <PackageReference Include="SQLitePCLRaw.core" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
    <ProjectReference Include="../uk.osric.asp.Runtime/uk.osric.asp.Runtime.csproj" />
    <ProjectReference Include="../uk.osric.asp.Sdk/uk.osric.asp.Sdk.csproj" />
    <!-- Build-only: the reference corpus is written after the assemblies and read from disk. It runs
         on this machine, not in the image, so the image's RID is removed before it is built: an arm64
         assembly cannot load in an x86 build host. The target below removes it as well, because the
         path it asks for has to be the path this build wrote. -->
    <ProjectReference Include="../../tools/reference-corpus/reference-corpus.csproj"
                      ReferenceOutputAssembly="false"
                      Private="false"
                      GlobalPropertiesToRemove="RuntimeIdentifier" />
  </ItemGroup>

  <ItemGroup>
    <!-- Page templates seeded into storage on first run; read from disk, never served directly. -->
    <Content Remove="Pages/Seeds/**" />
    <None Remove="Pages/Seeds/**" />
    <Content Include="Pages/Seeds/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- The web root is part of what the app serves. `dotnet publish` already carries it, and
         `dotnet run` finds it through the static web assets manifest; a host started from the build
         output, which is what the browser suite does, has neither, so the files are copied beside
         the assembly. -->
    <Content Update="wwwroot/**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The image carries the licence and notice files, not just the repository: /admin/copyright
         reads them, and a container has no checkout. -->
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../REUSE.toml" Link="REUSE.toml" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../LICENSES/*.txt" Link="LICENSES/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <!-- `make changelist` writes the deployed commit's history; /admin/changes serves it, and the
         image has no .git to read it from, so it is packed beside the assembly. -->
    <None Include="$(ChangelistFile)" Condition="'$(ChangelistFile)' != ''" Link="changes.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The build says what this assembly publishes: a new public symbol is an error until it is
         declared, and a removed one is an error until its line goes. The package adds the two files
         beside this project as AdditionalFiles itself, so they are not listed here: listing them
         again makes `dotnet format` warn that each is a duplicate source file. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="uk.osric.asp.Web.IntegrationTests" />
    <InternalsVisibleTo Include="uk.osric.asp.Web.Tests" />
  </ItemGroup>


  <!--
    The reference corpus is a build artifact: the compiler's XML documentation, the metadata beside
    it, the declarations Roslyn can spell and the links between entries. The site reads the JSON and
    renders it, so the work happens once per build rather than once per request.

    The four documents are declared here, before anything runs, so `Clean` removes them and
    `IncrementalClean` leaves them alone: a generated output nothing declares is a stray, and a stray
    in the output directory is what `IncrementalClean` deletes.
  -->
  <ItemGroup>
    <ReferenceCorpusOutput Include="$(OutDir)reference.core.json" />
    <ReferenceCorpusOutput Include="$(OutDir)reference.runtime.json" />
    <ReferenceCorpusOutput Include="$(OutDir)reference.sdk.json" />
    <ReferenceCorpusOutput Include="$(OutDir)reference.web.json" />
    <FileWrites Include="@(ReferenceCorpusOutput)" />
  </ItemGroup>

  <!-- Asks for the path the referenced build above produced; it must see the same properties that
       build did, or it names a file that is not there. A target of its own so the corpus below can
       read both items in its Inputs — and the input glob is taken here, after the build has written
       the assemblies, because a wildcard evaluated earlier matches nothing. -->
  <Target Name="GetReferenceCorpusTool">
    <MSBuild Projects="../../tools/reference-corpus/reference-corpus.csproj" Targets="GetTargetPath"
             RemoveProperties="RuntimeIdentifier">
      <Output TaskParameter="TargetOutputs" ItemName="ReferenceCorpusTool" />
    </MSBuild>
    <ItemGroup>
      <ReferenceCorpusInput Include="$(OutDir)uk.osric.asp.*.dll;$(OutDir)uk.osric.asp.*.xml" />
    </ItemGroup>
  </Target>

  <!-- The assemblies and their documentation are the whole input, so when none of them moved the
       JSON beside them is still the answer: the target says so rather than running Roslyn again. -->
  <Target Name="GenerateReferenceCorpus" AfterTargets="Build" DependsOnTargets="GetReferenceCorpusTool"
          Inputs="@(ReferenceCorpusTool);@(ReferenceCorpusInput)"
          Outputs="@(ReferenceCorpusOutput)">
    <PropertyGroup>
      <ReferenceCorpusHost Condition="'$(DOTNET_HOST_PATH)' != ''">$(DOTNET_HOST_PATH)</ReferenceCorpusHost>
      <ReferenceCorpusHost Condition="'$(ReferenceCorpusHost)' == ''">dotnet</ReferenceCorpusHost>
    </PropertyGroup>
    <!-- High importance: the tool says why it stopped, and a failing build should not need a second
         run at a higher verbosity to hear it. -->
    <Exec Command="&quot;$(ReferenceCorpusHost)&quot; &quot;@(ReferenceCorpusTool)&quot; &quot;$(OutDir)&quot;"
          StandardOutputImportance="high" StandardErrorImportance="high" />
  </Target>

  <!-- Publish copies the corpus beside the assembly, where the site reads it. The files are made
       after the build, so they are copied once the publish output exists rather than resolved with
       the files that were known when the project was evaluated. -->
  <Target Name="CopyReferenceCorpusToPublish" AfterTargets="Publish">
    <ItemGroup>
      <ReferenceCorpusFiles Include="$(OutDir)reference.*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceCorpusFiles)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
