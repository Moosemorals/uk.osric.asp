<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- Built with the SDK's container support (make image); see deploy/. -->
    <ContainerRepository>uk.osric.asp</ContainerRepository>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Metrics only: the exporter serves /metrics, and the hosting package registers the provider. -->
    <PackageReference Include="OpenTelemetry.Exporter.Prometheus.AspNetCore" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
    <ProjectReference Include="../uk.osric.asp.Runtime/uk.osric.asp.Runtime.csproj" />
    <ProjectReference Include="../uk.osric.asp.Sdk/uk.osric.asp.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Page templates seeded into storage on first run; read from disk, never served directly. -->
    <Content Remove="Pages/Seeds/**" />
    <None Remove="Pages/Seeds/**" />
    <Content Include="Pages/Seeds/**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="uk.osric.asp.Web.IntegrationTests" />
    <InternalsVisibleTo Include="uk.osric.asp.Web.Tests" />
  </ItemGroup>

</Project>
