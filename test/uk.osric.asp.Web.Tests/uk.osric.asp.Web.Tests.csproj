<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="NUnit" />
    <PackageReference Include="NUnit.Analyzers" PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter" />
  </ItemGroup>

  <ItemGroup>
    <!-- The corpus normaliser is the build tool's; the tests compile it directly so it stays tested. -->
    <Compile Include="../../tools/reference-corpus/Corpus/ReferenceDocument.cs" Link="Corpus/ReferenceDocument.cs" />
    <Compile Include="../../tools/reference-corpus/Corpus/ReferenceDisplay.cs" Link="Corpus/ReferenceDisplay.cs" />
    <Compile Include="../../tools/reference-corpus/Corpus/ReferenceText.cs" Link="Corpus/ReferenceText.cs" />
    <!-- Shared with the integration suite: both run the real compiler many times over the same
         seeded pages, and one definition keeps the cache they fill from drifting apart. -->
    <Compile Include="../Shared/CachingCompiler.cs" Link="Shared/CachingCompiler.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/uk.osric.asp.Core/uk.osric.asp.Core.csproj" />
    <ProjectReference Include="../../src/uk.osric.asp.Runtime/uk.osric.asp.Runtime.csproj" />
    <ProjectReference Include="../../src/uk.osric.asp.Sdk/uk.osric.asp.Sdk.csproj" />
    <ProjectReference Include="../../src/uk.osric.asp.Web/uk.osric.asp.Web.csproj" />
  </ItemGroup>

</Project>
