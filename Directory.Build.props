<Project>

  <!--
    Repository-wide build policy. Projects declare only what makes them different:
    their SDK, their output type and their references.
  -->
  <PropertyGroup>
    <RepoRoot>$(MSBuildThisFileDirectory)</RepoRoot>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!--
      Runtime async is still preview in .NET 11: an await suspends on the runtime rather than in a
      compiler state machine. Measured here from 144 B per synchronously completing await to none,
      and 23% off the Web assembly. The feature is spelled with =on; the bare name is ignored.
    -->
    <Features>runtime-async=on</Features>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!--
      The full CA rule set, including the rules the SDK leaves off because they are noisy in general.
      TreatWarningsAsErrors is set below, so a violation is a build failure rather than advice;
      .editorconfig names the handful this codebase deliberately does not follow, with the reason, so
      every exception is a decision someone can read.
    -->
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <UseArtifactsOutput>true</UseArtifactsOutput>
    <IsPackable>false</IsPackable>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!--
      A warning nobody reads is a failure nobody noticed. Treating warnings as errors here rather
      than only in the gate keeps one build: what `make build` proves is what `make check` proves,
      and the stamps in artifacts/ can never mean a stricter build than the one they recorded.
    -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!--
      Normalise source paths in the PDB so the same commit compiles to the same output wherever the
      checkout happens to live: the machine that builds an image is not part of the image.
    -->
    <ContinuousIntegrationBuild Condition="'$(ContinuousIntegrationBuild)' == ''">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!--
    Test projects are recognised by name suffix so none of them repeats test settings. The suffix is
    read here rather than in Directory.Build.targets because a documentation file has to be decided
    before the SDK targets that look for one.
  -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
    <!--
      A product assembly publishes its own documentation, and an undocumented public member is then a
      build failure (CS1591). Test and tool projects hold no surface anything binds to, and a fixture
      has to be public for NUnit, so they are left out.
    -->
    <GenerateDocumentationFile Condition="'$(IsTestProject)' != 'true'">true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
