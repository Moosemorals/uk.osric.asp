<Project>

  <!--
    The tainted-data rules (CA3001-CA3012: SQL injection, XSS and the rest of the family) run a
    data-flow pass over the whole compilation, and together they cost about 24 of the 31 seconds
    Web takes to compile. A development build cannot spend that on every edit, so Debug leaves them
    out; every other configuration runs them, which is what makes a deployment build strict. Release
    is the deployment configuration the Makefile publishes and images, and `make check` runs that
    publish, so a rule found there still fails the gate before anything ships. The condition names
    Debug rather than Release so a configuration nobody anticipated gets the analysis rather than a
    silent exemption.

    This sits here rather than beside `AnalysisMode` because the SDK's own props set `$(NoWarn)` too,
    and appending after them is what keeps their defaults. `$(Configuration)` is still empty for a
    bare `dotnet build`, which names none and lets the SDK default it to Debug, so empty is Debug.
  -->
  <PropertyGroup Condition="'$(Configuration)' == '' or '$(Configuration)' == 'Debug'">
    <NoWarn>$(NoWarn);CA3001;CA3002;CA3003;CA3004;CA3005;CA3006;CA3007;CA3008;CA3009;CA3010;CA3011;CA3012</NoWarn>
  </PropertyGroup>

  <!--
    Every test asserts, so the framework is one project-wide using rather than a line repeated in
    every file. Helpers and fakes in a test project share it with no harm.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    The repository root is embedded in test assemblies so tests can locate the web app
    without depending on the working directory they happen to be run from.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(RepoRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The about page names the commit it is serving. Git is the source of truth, and only the one
    assembly that serves pages needs it; a build that is not from a checkout records no commit, and
    the page says so rather than showing a guess.
  -->
  <Target Name="ReadGitCommit"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectName)' == 'uk.osric.asp.Web' and Exists('$(RepoRoot).git')">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(RepoRoot)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <ItemGroup Condition="'$(GitCommit.Trim())' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommit</_Parameter1>
        <_Parameter2>$(GitCommit.Trim())</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <!--
    The reference corpus is written by the site's build and read from disk. A test that reads it
    needs it beside the test assembly, so the one copy the site produced is copied down.
  -->
  <Target Name="CopyReferenceCorpus"
          AfterTargets="Build"
          Condition="'$(IsTestProject)' == 'true'">
    <ItemGroup>
      <ReferenceCorpusFiles Include="$(ArtifactsPath)/bin/uk.osric.asp.Web/$(Configuration.ToLowerInvariant())/reference.*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(ReferenceCorpusFiles)"
          DestinationFolder="$(OutDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ReferenceCorpusFiles)' != ''" />
  </Target>

</Project>
