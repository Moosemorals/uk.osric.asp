<Project>

  <!--
    Test projects are recognised by name suffix so none of them repeats test settings.
  -->
  <PropertyGroup>
    <IsTestProject Condition="$(MSBuildProjectName.EndsWith('Tests'))">true</IsTestProject>
  </PropertyGroup>

  <!--
    Every test asserts, so the framework is one project-wide using rather than a line repeated in
    every file. Helpers and fakes in a test project share it with no harm.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <Using Include="NUnit.Framework" />
  </ItemGroup>

  <!--
    The repository root is embedded in test assemblies so tests can locate the web app
    without depending on the working directory they happen to be run from.
  -->
  <ItemGroup Condition="'$(IsTestProject)' == 'true'">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>RepoRoot</_Parameter1>
      <_Parameter2>$(RepoRoot)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <!--
    The about page names the commit it is serving. Git is the source of truth, and only the one
    assembly that serves pages needs it; a build that is not from a checkout records no commit, and
    the page says so rather than showing a guess.
  -->
  <Target Name="ReadGitCommit"
          BeforeTargets="GetAssemblyAttributes"
          Condition="'$(MSBuildProjectName)' == 'uk.osric.asp.Web' and Exists('$(RepoRoot).git')">
    <Exec Command="git rev-parse HEAD"
          WorkingDirectory="$(RepoRoot)"
          ConsoleToMSBuild="true"
          StandardOutputImportance="low"
          StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <ItemGroup Condition="'$(GitCommit.Trim())' != ''">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>GitCommit</_Parameter1>
        <_Parameter2>$(GitCommit.Trim())</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

</Project>
